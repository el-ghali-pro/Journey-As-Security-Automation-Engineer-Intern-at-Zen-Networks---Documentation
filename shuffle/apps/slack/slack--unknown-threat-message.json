{
  "channel": "{{SLACK_CHANNEL_ID}}",
  "icon_emoji": ":shield:",
  "link_names": true,
  "mrkdwn": true,
  "blocks": [
    {
      "type": "header",
      "text": {
        "type": "plain_text",
        "text": "🔴 Zabbix Alert - Unknown Threat - REVIEW NEEDED",
        "emoji": true
      }
    },
    {
      "type": "section",
      "fields": [
        {
          "type": "mrkdwn",
          "text": "*Event Details:*"
        },
        {
          "type": "mrkdwn",
          "text": "*Jira Ticket:*"
        }
      ]
    },
    {
      "type": "section",
      "fields": [
        {
          "type": "mrkdwn",
          "text": "• *IP:* `$parsetojson.message.ioc` *(Internal Network)*\n• *Hostname:* `$parsetojson.message.host_name`\n• *Host IP:* `$parsetojson.message.host_ip`\n• *Alert:* `$parsetojson.message.problem_name`\n• *Time:* `$parsetojson.message.time` on `$parsetojson.message.date`"
        },
        {
          "type": "mrkdwn",
          "text": "• *ID:* `$jira_4_-_confirm_private_ip.body.id`\n• *Key:* `$jira_4_-_confirm_private_ip.body.key`\n• <$JIRA_BASE_URL/jira/servicedesk/projects/$JIRA_PROJECT_KEY/queues/custom/$JIRA_QUEUE_ID/$jira_4_-_confirm_private_ip.body.key|View Ticket>"
        }
      ]
    },
    {
      "type": "section",
      "fields": [
        {
          "type": "mrkdwn",
          "text": "*MITRE ATT&CK:*"
        },
        {
          "type": "mrkdwn",
          "text": "*Response:*"
        }
      ]
    },
    {
      "type": "section",
      "fields": [
        {
          "type": "mrkdwn",
          "text": "<$parsetojson.message.info_url|View TTPs>"
        },
        {
          "type": "mrkdwn",
          "text": "⚠️ *Internal IP detected*\n• No automatic blocking applied\n• Manual investigation required"
        }
      ]
    },
    {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This IP was not flagged as malicious by VirusTotal (score >= 0) and has a low AbuseIPDB confidence score. Manual analyst review is required to determine if this is a false positive or a new threat."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Alert Details"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Event ID: ",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "$parsetojson.message.event_id"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Problem Name: ",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "$parsetojson.message.problem_name"
            },
            {
              "type": "hardBreak"
            }
          ]
        },
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": "🕐 Alert automatically generated by Zabbix | An issue is opened automatically in Jira"
        }
      ]
    }
  ],
  "text": "Zabbix Alert - Internal Threat: $parsetojson.message.problem_name"
}